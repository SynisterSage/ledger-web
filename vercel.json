{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/html-pages/download.html" },
    { "source": "/about", "destination": "/html-pages/about.html" },
    { "source": "/sidebar", "destination": "/html-pages/sidebar.html" },
    { "source": "/planning", "destination": "/planning.html" },
    { "source": "/review", "destination": "/html-pages/review.html" }
  ]
}
