{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "redirects": [
    { "source": "/about", "destination": "/features", "permanent": true },
    { "source": "/sidebar", "destination": "/features/desktop", "permanent": true },
    { "source": "/planning", "destination": "/features", "permanent": true },
    { "source": "/review", "destination": "/features", "permanent": true },
    { "source": "/desktop-app", "destination": "/features/desktop", "permanent": true },
    { "source": "/mobile-app", "destination": "/features/mobile", "permanent": true },
    { "source": "/browser-extension", "destination": "/features/browser", "permanent": true },
    { "source": "/integrations", "destination": "/features/integrations", "permanent": true },
    { "source": "/docs", "destination": "/help", "permanent": true },
    { "source": "/docs/index", "destination": "/help", "permanent": true },
    { "source": "/docs/start-guide", "destination": "/help/getting-started", "permanent": true },
    { "source": "/docs/workspace", "destination": "/help/workspaces", "permanent": true },
    { "source": "/docs/workspaces", "destination": "/help/workspaces", "permanent": true },
    { "source": "/docs/notes", "destination": "/help/notes", "permanent": true },
    { "source": "/docs/projects", "destination": "/help/projects", "permanent": true },
    { "source": "/docs/capture", "destination": "/help/capture", "permanent": true },
    { "source": "/docs/today", "destination": "/help/today", "permanent": true },
    { "source": "/docs/actions", "destination": "/help/actions", "permanent": true },
    { "source": "/docs/calendar", "destination": "/help/calendar", "permanent": true },
    { "source": "/docs/notifications", "destination": "/help/notifications", "permanent": true },
    { "source": "/docs/search", "destination": "/help/search", "permanent": true },
    { "source": "/docs/mobile", "destination": "/help/mobile", "permanent": true },
    { "source": "/docs/browser-extension", "destination": "/help/browser-extension", "permanent": true },
    { "source": "/docs/siri-shortcuts", "destination": "/help/shortcuts", "permanent": true },
    { "source": "/docs/sessions-account", "destination": "/help/account", "permanent": true },
    { "source": "/docs/contact-support", "destination": "/help/contact", "permanent": true },
    { "source": "/docs/troubleshooting", "destination": "/help/troubleshooting", "permanent": true },
    { "source": "/help/start-guide", "destination": "/help/getting-started", "permanent": true },
    { "source": "/help/workspace", "destination": "/help/workspaces", "permanent": true },
    { "source": "/help/contact-support", "destination": "/help/contact", "permanent": true },
    { "source": "/help/siri-shortcuts", "destination": "/help/shortcuts", "permanent": true },
    { "source": "/help/sessions-account", "destination": "/help/account", "permanent": true }
  ],
  "rewrites": [
    { "source": "/integrations/mcp/authorize", "destination": "/index.html" },
    { "source": "/integrations/mcp/switch-workspace", "destination": "/index.html" },
    { "source": "/download", "destination": "/html-pages/download.html" },
    { "source": "/features", "destination": "/features/index.html" },
    { "source": "/features/(.*)", "destination": "/features/index.html" },
    { "source": "/help", "destination": "/help/index.html" },
    { "source": "/help/(.*)", "destination": "/help/index.html" },
    { "source": "/changelog", "destination": "/html-pages/changelog.html" },
    { "source": "/login", "destination": "/html-pages/login.html" },
    { "source": "/invite/(.*)", "destination": "/html-pages/invite.html" },
    { "source": "/joined", "destination": "/html-pages/joined.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" }
  ]
}
